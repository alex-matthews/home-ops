{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#8.1.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#8.1.0",
    ":timezone(Pacific/Auckland)",
  ],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am on the first day of the month"],
  },
  packageRules: [
    // Automerge
    {
      description: "Auto-merge trusted OCI digests",
      matchDatasources: ["docker"],
      matchPackageNames: ["/home-operations/"],
      matchUpdateTypes: ["digest"],
      automerge: true,
    },
    {
      description: "Auto-merge high-cadence OCI packages weekly",
      matchDatasources: ["docker"],
      matchPackageNames: ["/kube-prometheus-stack/"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      schedule: ["before 6am on Monday"],
    },
    {
      description: "Auto-merge GitHub Actions; 0.x minors are treated as major by the preset and stay manual",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      matchCurrentVersion: "!/^v?0\\./",
      automerge: true,
      minimumReleaseAge: "3 days",
    },
    {
      description: "Auto-merge Grafana dashboards",
      matchDatasources: ["custom.grafana-dashboards"],
      matchUpdateTypes: ["major"],
      automerge: true,
    },
    {
      description: "Require review for Renovate presets",
      matchManagers: ["renovate-config"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: false,
    },
    // Version holds
    {
      description: "Hold coredns chart at 1.46.2: CoreDNS >=1.14.3 breaks autopath during cache prefetch, https://www.github.com/coredns/coredns/issues/8390",
      matchDatasources: ["docker"],
      matchPackageNames: ["/coredns/"],
      allowedVersions: "<=1.46.2",
    },
    // Groups
    {
      description: "Actions Runner Controller Group",
      groupName: "actions-runner-controller",
      matchDatasources: ["docker"],
      matchPackageNames: ["/gha-runner-scale-set-controller/", "/gha-runner-scale-set/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Kopiur Group",
      groupName: "kopiur",
      matchPackageNames: ["ghcr.io/home-operations/charts/kopiur", "home-operations/kopiur"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Kubernetes Group: control-plane and kubelet images plus the kubectl mise pin, as the Talos group unites talosctl with its images",
      groupName: "kubernetes",
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
        "kubernetes/kubernetes",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 6,
    },
    {
      description: "Rook-Ceph Group",
      groupName: "rook-ceph",
      matchDatasources: ["docker"],
      matchPackageNames: ["/rook-ceph/", "/rook-ceph-cluster/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "ToolHive Group",
      groupName: "toolhive",
      matchDatasources: ["docker"],
      matchPackageNames: ["/toolhive-operator$/", "/toolhive-operator-crds$/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Strip the v prefix from group titles whose members disagree on it",
      matchPackageNames: ["/flux-operator/", "/flux-instance/", "siderolabs/talos"],
      matchUpdateTypes: ["major", "minor", "patch"],
      commitMessageExtra: "({{{replace '^v' '' currentVersion}}} ➔ {{{replace '^v' '' newVersion}}})",
    },
    // Labels: update type
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    // Labels: source
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["custom.grafana-dashboards"],
      addLabels: ["renovate/grafana-dashboard"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["mise"],
      addLabels: ["renovate/mise"],
    },
    {
      matchDatasources: ["custom.talos-factory"],
      addLabels: ["renovate/talos"],
    },
  ],
}
