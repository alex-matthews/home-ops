#!/usr/bin/env bash
# Stand-in for an external tool inside a fixture. The case directory's
# responses.psv has one pipe-separated line per answer: tool, glob pattern
# over the argument string, exit code, stdout (a file under the case, or
# literal text), stderr text. Pipes, not tabs, because bash's read collapses
# consecutive tabs and an empty stdout field would shift the columns. First match wins; an unmatched call fails the case loudly.
set -uo pipefail
tool="$(basename "$0")"; args="$*"
# yq is deterministic and offline, so the real one runs, resolved through the repository's mise config.
if [ "$tool" = yq ]; then root="$(cd "$(dirname "$0")/../../.." && pwd)"; exec "$(mise -C "$root" which yq)" "$@"; fi
: "${CASE_DIR:?CASE_DIR must name the fixture}"
while IFS='|' read -r t pat code out err; do
  [ "$t" = "$tool" ] || continue
  # shellcheck disable=SC2053
  [[ "$args" == $pat ]] || continue
  if [ -n "$out" ]; then
    if [ -f "$CASE_DIR/$out" ]; then content="$(cat "$CASE_DIR/$out")"; else content="$out"; fi
    printf '%s\n' "$content"
  fi
  [ -n "$err" ] && printf '%s\n' "$err" >&2
  exit "${code:-0}"
done < "$CASE_DIR/responses.psv"
echo "unmatched $tool call: $args" >&2; exit 99
