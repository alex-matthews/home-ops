.diff.resources[$i] | "## resource \($i): \(.status) \(.kind) \(.name) rows \($from) to \([$to, (.unified | length)] | min) of \(.unified | length)", (.unified[$from:$to][] | select(.folded != true) | if .hunk then "@@ \(.count // 0) unchanged lines folded @@" else (if .kind == "add" then "+" elif .kind == "del" then "-" else " " end) + ((.html // "") | gsub("<[^>]*>"; "") | gsub("&lt;"; "<") | gsub("&gt;"; ">") | gsub("&quot;"; "\"") | gsub("&#39;"; "'") | gsub("&#34;"; "\"") | gsub("&amp;"; "&")) end)
