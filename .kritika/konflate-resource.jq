.diff.resources[$i] | (.unified | map(select(.folded != true))) as $rows | "## resource \($i): \(.status) \(.kind) \(.name) rows \($from) to \([$to, ($rows | length)] | min) of \($rows | length)", ($rows[$from:$to][] | if .hunk then "@@ \(.count // 0) unchanged lines folded @@" else (if .kind == "add" then "+" elif .kind == "del" then "-" else " " end) + ((.html // "") | gsub("<[^>]*>"; "") | gsub("&lt;"; "<") | gsub("&gt;"; ">") | gsub("&quot;"; "\"") | gsub("&#39;"; "'") | gsub("&#34;"; "\"") | gsub("&amp;"; "&")) end)
